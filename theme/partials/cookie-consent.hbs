{{!-- GDPR/CCPA Cookie Consent Banner --}}
<div id="cookie-banner" class="cookie-banner" role="dialog" aria-label="Cookie consent" style="display:none">
  <div class="cookie-inner">
    <div class="cookie-text">
      <strong>We use cookies</strong> to improve your experience, personalize content, and serve relevant advertising.
      By continuing you agree to our <a href="/privacy-policy/">Privacy Policy</a>.
    </div>
    <div class="cookie-actions">
      <button class="cookie-btn cookie-decline" id="cookie-decline">Decline Non-Essential</button>
      <button class="cookie-btn cookie-accept" id="cookie-accept">Accept All</button>
    </div>
  </div>
</div>
