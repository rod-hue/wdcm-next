<!-- Article Schema (JSON-LD) -->
<script type="application/ld+json" id="wdcm-article-schema">
{
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": "{{#if title}}{{title}}{{else}}{{meta_title}}{{/if}}",
  "datePublished": "{{date format='YYYY-MM-DDTHH:mm:ssZ'}}",
  "dateModified": "{{date updated_at format='YYYY-MM-DDTHH:mm:ssZ'}}",
  {{#if feature_image}}"image": "{{feature_image}}",{{/if}}
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{{url absolute='true'}}"
  },
  "publisher": {
    "@type": "NewsMediaOrganization",
    "name": "Washington DC Magazine",
    "url": "https://washingtondcmagazine.com",
    "logo": {
      "@type": "ImageObject",
      "url": "https://washingtondcmagazine.com/images/logo.png"
    }
  },
  "author": {{#primary_author}}{{#has slug="rod"}}{"@type": "Person", "@id": "https://rodriquezwright.com/#person", "name": "Rodriquez Wright II", "jobTitle": "Editor in Chief", "url": "https://www.washingtondcmagazine.com/author/rod/", "sameAs": ["https://rodriquezwright.com/", "https://leooperations.com/team/rodriquez-wright-ii/", "https://www.instagram.com/rod212", "https://www.linkedin.com/in/rodriquez-wright-ii-62523049"]}{{else}}{
    "@type": "Person",
    "name": "{{name}}",
    "url": "https://www.washingtondcmagazine.com/author/{{slug}}/"
  }{{/has}}{{else}}{"@type": "Organization", "name": "Washington DC Magazine"}{{/primary_author}},
  "editor": {"@type": "Person", "@id": "https://rodriquezwright.com/#person", "name": "Rodriquez Wright II", "jobTitle": "Editor in Chief", "url": "https://www.washingtondcmagazine.com/author/rod/", "sameAs": ["https://rodriquezwright.com/", "https://leooperations.com/team/rodriquez-wright-ii/", "https://www.instagram.com/rod212", "https://www.linkedin.com/in/rodriquez-wright-ii-62523049"]},
  "description": "{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{meta_description}}{{/if}}"
}
</script>

<!-- Breadcrumb Schema (JSON-LD) -->
<script type="application/ld+json" id="wdcm-breadcrumb-schema">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://washingtondcmagazine.com" },
    {{#primary_tag}}{ "@type": "ListItem", "position": 2, "name": "{{name}}", "item": "https://washingtondcmagazine.com/tag/{{slug}}/" },{{/primary_tag}}
    { "@type": "ListItem", "position": {{#primary_tag}}3{{else}}2{{/primary_tag}}, "name": "{{#if title}}{{title}}{{else}}{{meta_title}}{{/if}}" }
  ]
}
</script>
